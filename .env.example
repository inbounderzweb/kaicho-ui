# Google Tag Manager container ID. GTM IDs are not secrets (they're
# public in the browser regardless), but the value is still environment-
# specific — leave unset locally; the app works normally without it.
NEXT_PUBLIC_GTM_ID=

# Canonical production domain used for canonical URLs, sitemap.xml,
# robots.txt, and Open Graph/Twitter absolute URLs. Leave unset to fall
# back to https://kaicho.in (see lib/seo/urls.ts). Only set this for
# staging/preview deployments that need a different canonical domain.
NEXT_PUBLIC_SITE_URL=

# Search engine ownership verification tokens (Google Search Console,
# Bing Webmaster Tools). Leave unset until you actually have real tokens —
# lib/seo/metadata.ts omits the corresponding <meta> tag when unset rather
# than emitting a fake/placeholder verification tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Base URL of the Kaicho backend API (kaicho-be). Requests are sent with
# credentials included so the HttpOnly session cookie round-trips correctly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Origin that serves backend media (product/category/brand images under
# /uploads/media/...). resolveMediaUrl joins this with the root-relative
# path the API returns. Keep it as the backend's own origin
# (http://localhost:4000 locally, the real domain in production). Set it
# explicitly when NEXT_PUBLIC_API_BASE_URL points at a dev tunnel so images
# still load straight from the backend instead of round-tripping the tunnel.
# Leave unset to fall back to NEXT_PUBLIC_API_BASE_URL with /api stripped.
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:4000

# Razorpay publishable key id, used to open the Checkout.js modal at
# /checkout. This is the PUBLIC half of the pair and is safe in the browser —
# the secret (RAZORPAY_KEY_SECRET) lives only in kaicho-be and must never be
# added here. Must match the key id the backend creates orders with (test
# key with test backend, live with live). Leave unset to disable online
# payment: checkout then tells the customer to use Cash on Delivery instead
# of opening a modal that would fail.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
